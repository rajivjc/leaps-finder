# Copy to apps/web/.env.local — it is git-ignored.
# In production these are Vercel environment variables.
#
# The anon key is safe to expose to the browser: RLS is what protects the data.
# Never put the service key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
